# Normalize line endings; Windows batch files need CRLF, shell scripts LF
* text=auto
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf
"QqQ lab.app/Contents/MacOS/*" text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.wasm binary

# Third-party bundles (Ketcher, OpenChemLib): no diffs, not counted as project code
qqq_lab/web/vendor/** -diff linguist-vendored
