# Normalize line endings; shell scripts LF
* text=auto
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.wasm binary

# Third-party bundles (Ketcher, OpenChemLib): no diffs, not counted as project code
mzlab/web/vendor/** -diff linguist-vendored
