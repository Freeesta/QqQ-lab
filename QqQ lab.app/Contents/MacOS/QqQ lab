#!/bin/bash
# Mac launcher as an app (double click in Finder, it has the QqQ lab icon). It opens ONE Terminal window that runs
# 'Avvia QqQ lab.command' (which does the real work through scripts/avvia.py). Opening the .command directly also
# works, but when Terminal is not running macOS opens its own empty window too: here that window is reused.
APP="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP")"
CMD="cd $(printf %q "$ROOT") && bash ./Avvia\\ QqQ\\ lab.command; exit"
/usr/bin/osascript - "$CMD" <<'OSA'
on run argv
	set cmd to item 1 of argv
	if application "Terminal" is running then
		tell application "Terminal"
			do script cmd
			activate
		end tell
	else
		tell application "Terminal"
			activate
			delay 0.6
			if (count of windows) > 0 then
				do script cmd in window 1
			else
				do script cmd
			end if
		end tell
	end if
end run
OSA
